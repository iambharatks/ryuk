{
  "permissions": {
    "deny": [
      "Read(./.dev.vars)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/backup-*.sql)"
    ],
    "ask": [
      "Bash(npx wrangler deploy:*)",
      "Bash(npm run deploy:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(npx wrangler d1 execute:*)",
      "Bash(npx wrangler d1 export:*)",
      "Bash(git push:*)"
    ],
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run test:sms)",
      "Bash(npm run build:ui)",
      "Bash(npm run build:demo)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ]
  }
}
